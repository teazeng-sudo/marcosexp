---
import '../styles/global.css';
import { SITE, CATEGORIES, LESSONS, url } from '../config';
interface Props { title?: string; description?: string; current?: string; noindex?: boolean }
const { title, description = SITE.description, current, noindex = false } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg').replace(/\/$/, '')} />
  <!-- LINE／Facebook 分享預覽 -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title ?? SITE.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="zh_TW" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@400;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <a class="brand" href={url()}>{SITE.name}</a>
    <nav aria-label="分類">
      {CATEGORIES.map((c) => (
        <a href={url(`category/${c.id}`)} aria-current={current === c.id ? 'page' : undefined}>{c.name}</a>
      ))}
      <a href={url('lessons')} aria-current={current === 'lessons' ? 'page' : undefined}>{LESSONS.name}</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <p>這裡寫的是經驗與觀念，不是法律或財務意見。遇到金額大、牽涉合約的事，請找律師或會計師確認。</p>
    <p>© {new Date().getFullYear()} {SITE.author}</p>
  </footer>
</body>
</html>
